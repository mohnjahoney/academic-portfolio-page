{
  "name": "academic-portfolio-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run glyphs",
    "dev": "vite",
    "build": "npm run glyphs:check && vite build && mkdir -p dist/assets/article-pdfs dist/assets/images-from-pdfs && cp -R assets/article-pdfs/. dist/assets/article-pdfs && cp -R assets/images-from-pdfs/. dist/assets/images-from-pdfs",
    "glyphs": "node scripts/generate-title-glyphs.mjs",
    "glyphs:check": "node scripts/generate-title-glyphs.mjs --check",
    "download:pdfs": "bash scripts/download-pdfs.sh",
    "extract:figures": "node scripts/extract-figures-from-pdfs.mjs",
    "concept:prompt": "node scripts/prepare-paper-concept-prompt.mjs",
    "trim:figures": "node scripts/trim-figure-whitespace.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
