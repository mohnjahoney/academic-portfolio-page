{
  "name": "academic-portfolio-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && cp -R pdfs dist/pdfs && cp -R images-from-pdfs dist/images-from-pdfs",
    "download:pdfs": "bash scripts/download-pdfs.sh",
    "extract:figures": "node scripts/extract-figures-from-pdfs.mjs",
    "trim:figures": "node scripts/trim-figure-whitespace.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "vite": "^8.0.13"
  }
}
